    "parents.privacy.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animal Pairs works offline. It does not collect names, birthdays, email addresses, photos, location or advertising identifiers. There are no accounts, chat, ads or third-party analytics, and game progress stays on this iPad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Animal Pairs เล่นได้แบบออฟไลน์ ไม่เก็บชื่อ วันเกิด อีเมล รูปภาพ ตำแหน่ง หรือรหัสโฆษณา ไม่มีบัญชีผู้ใช้ แชท โฆษณา หรือการวิเคราะห์จากบุคคลที่สาม และความคืบหน้าของเกมอยู่ใน iPad เครื่องนี้เท่านั้น"
          }
        }
      }
    },
