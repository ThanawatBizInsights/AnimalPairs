{
  "openapi": "3.1.0",
  "info": {
    "title": "Animal Pairs Content Service",
    "description": "Optional versioned artwork catalog, signed downloads and Apple purchase verification.",
    "version": "1.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "Health",
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/catalog": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "Catalog",
        "operationId": "catalog_v1_catalog_get",
