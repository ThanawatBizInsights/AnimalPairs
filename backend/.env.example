# Copy to .env (never commit .env). All settings use the AP_ prefix.
AP_ENVIRONMENT=development
AP_DATABASE_URL=postgresql+psycopg://animalpairs:animalpairs@localhost:5432/animalpairs

# Admin API: store only the SHA-256 of the token.
#   python -c "import hashlib,secrets;t=secrets.token_urlsafe(32);print(t);print(hashlib.sha256(t.encode()).hexdigest())"
AP_ADMIN_TOKEN_SHA256=

# Apple verification. Download Apple root certificates (DER .cer) from
# https://www.apple.com/certificateauthority/ and list their paths as JSON.
AP_APPLE_BUNDLE_ID=com.example.AnimalPairs
AP_APPLE_ENVIRONMENT=Sandbox
AP_APPLE_APP_APPLE_ID=
AP_APPLE_ROOT_CERT_PATHS=[]
AP_APPLE_ENABLE_ONLINE_CHECKS=true
AP_FULL_UNLOCK_PRODUCT_ID=com.example.animalpairs.fullgame

# Storage: "local" (development, HMAC-signed links) or "s3" (private bucket).
AP_STORAGE_BACKEND=local
AP_LOCAL_STORAGE_DIR=.data/assets
AP_LOCAL_SIGNING_KEY=
AP_PUBLIC_BASE_URL=http://localhost:8000
AP_S3_BUCKET=
AP_S3_REGION=
AP_DOWNLOAD_URL_TTL_SECONDS=300
